# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
# Use your own app URL here, not a Neon Auth endpoint.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# OpenRouter primary provider
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# Required when AI integration is enabled. Use a model ID from https://openrouter.ai/models
OPENROUTER_MODEL=replace-with-an-openrouter-model-id free model endpoint

# Groq fallback provider
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=replace-with-your-groq-model-id gpt oss 120b
